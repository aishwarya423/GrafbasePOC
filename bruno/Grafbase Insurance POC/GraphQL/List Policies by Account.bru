meta {
  name: List Policies by Account
  type: http
  seq: 4
}

post {
  url: {{graphql_url}}
  body: graphql
  auth: none
}

headers {
  Content-Type: application/json
}

body:graphql {
  query PoliciesByAccount {
    policies(accountId: "acct-1001") {
      id
      policyNumber
      policyType
      productName
      status
      premiumMonthly
      sumAssured
      linkedFunds {
        id
        name
        assetClass
      }
    }
  }
}
